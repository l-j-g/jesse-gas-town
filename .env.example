# Local research server only. Do not add exchange API keys for this repo.
APP_PORT=9000
APP_HOST=127.0.0.1
PASSWORD=local-research-only
IS_DEV_ENV=TRUE
LSP_PORT=9001

# Local service defaults used by Jesse. These are not exchange credentials.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_NAME=jesse_db
POSTGRES_USERNAME=jesse_user
POSTGRES_PASSWORD=password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Jesse MCP is exposed by `jesse run` on a separate local endpoint when supported.
# Codex expects http://localhost:9002/mcp for the `jesse` MCP server.
